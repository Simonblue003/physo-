{
  "expo": {
    "name": "Desk Reset",
    "slug": "desk-reset",
    "owner": "martiankings",
    "version": "1.0.0",
    "platforms": ["android", "ios"],
    "sdkVersion": "50.0.0",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.martiankings.deskreset",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.martiankings.deskreset"
    },
    "extra": {
      "eas": {
        "projectId": "ec60ae2e-cef0-40bb-8cd4-b51730bf5998"
      },
      "SUPABASE_URL": "__SET_IN_EAS_OR_app.config.js__",
      "SUPABASE_ANON_KEY": "__SET_IN_EAS_OR_app.config.js__"
    }
  }
}
